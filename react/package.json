{
  "name": "web3-avatar-react",
  "description": "React component for generating beautiful Web3 gradient avatars",
  "private": false,
  "version": "1.0.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackHamer09/web3-avatar.git",
    "directory": "react"
  },
  "keywords": [
    "avatar",
    "web3",
    "react",
    "gradient",
    "address",
    "generator",
    "ethereum",
    "eth"
  ],
  "author": "JackHamer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JackHamer09/web3-avatar/issues"
  },
  "homepage": "https://web3-avatar.netlify.app/",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "web3-avatar": "^1.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.2.1",
    "vitest": "^4.0.7"
  }
}
